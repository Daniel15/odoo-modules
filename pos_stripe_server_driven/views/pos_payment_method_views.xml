<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_stripe_sd" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.stripe.server.driven</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field
                    name="stripe_reader_id"
                    invisible="use_payment_terminal != 'stripe_server_driven'"
                />
                <div
                    colspan="2"
                    class="mt16"
                    invisible="use_payment_terminal != 'stripe_server_driven'"
                >
                    <button
                        name="action_stripe_sd_provider_settings"
                        type="object"
                        icon="oi-arrow-right"
                        string="Configure Stripe API keys in the payment provider settings."
                        class="btn-link"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
