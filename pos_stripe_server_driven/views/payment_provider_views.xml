<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_provider_view_form_stripe_sd" model="ir.ui.view">
        <field name="name">payment.provider.form.stripe.server.driven</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment_stripe.payment_provider_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='stripe_credentials']//label[@for='stripe_webhook_secret']"
                position="before"
            >
                <label for="stripe_terminal_webhook_secret" />
                <div class="o_row" col="2">
                    <field name="stripe_terminal_webhook_secret" password="True" />
                    <button
                        name="action_stripe_sd_create_webhook"
                        type="object"
                        class="btn-primary"
                        string="Generate your Webhook"
                        invisible="stripe_terminal_webhook_secret or not stripe_secret_key"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
