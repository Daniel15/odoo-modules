<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_provider_view_form_stripe_sd_legacy" model="ir.ui.view">
        <field name="name">payment.provider.form.stripe.server.driven.legacy</field>
        <field name="model">payment.provider</field>
        <field
            name="inherit_id"
            ref="payment_stripe_terminal_base.payment_provider_view_form_stripe_terminal"
        />
        <field name="arch" type="xml">
            <field name="stripe_terminal_webhook_route_token" position="after">
                <field name="stripe_terminal_legacy_webhook_secret" invisible="True" />
            </field>
            <button name="action_stripe_terminal_update_webhook" position="after">
                <button
                    name="action_stripe_terminal_retire_legacy_webhook"
                    type="object"
                    class="btn-secondary"
                    string="Retire Legacy Webhook"
                    groups="base.group_system"
                    invisible="not stripe_terminal_legacy_webhook_secret"
                    confirm="Remove the old endpoint from Stripe before clearing its signing secret. Continue?"
                />
            </button>
        </field>
    </record>
</odoo>
