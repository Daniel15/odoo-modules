<odoo>
    <record id="survey_question_form_text_content" model="ir.ui.view">
        <field name="name">survey.question.form.text_content</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form" />
        <field name="arch" type="xml">
            <!-- Add preview for text_content question type -->
            <xpath
                expr="//div[@invisible=&quot;question_type != 'scale'&quot;]"
                position="after"
            >
                <div invisible="question_type != 'text_content'">
                    <i
                        class="fa fa-align-justify fa-4x"
                        role="img"
                        aria-label="Text content"
                        title="Text Content"
                    />
                </div>
            </xpath>

            <!-- Add content_html editor inside the Answers tab -->
            <xpath
                expr="//page[@name='answers']/field[@name='matrix_row_ids']"
                position="after"
            >
                <field
                    name="content_html"
                    widget="html"
                    options="{'embedded_components': false}"
                    placeholder="Enter the text content to display in the survey..."
                    invisible="question_type != 'text_content'"
                />
            </xpath>

            <!-- Hide the Options tab for text_content -->
            <xpath expr="//page[@name='options']" position="attributes">
                <attribute
                    name="invisible"
                >is_page or question_type == 'text_content'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
